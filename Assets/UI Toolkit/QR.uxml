<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="CanvasPrincipal" style="flex-grow: 1;">
        <ui:VisualElement name="Header" style="flex-grow: 0; flex-shrink: 0; height: 50%; width: 100%; align-items: center;">
            <ui:VisualElement name="Barra" style="flex-grow: 0; flex-shrink: 0; height: 30%; flex-direction: row; align-items: center; justify-content: center; margin-top: 100px; width: 95%;">
                <ui:VisualElement name="ContenedorUbicacion" style="flex-grow: 0; flex-shrink: 0; width: 60%; height: 50%; background-color: rgba(0, 0, 0, 0.51); border-top-left-radius: 35px; border-top-right-radius: 35px; border-bottom-right-radius: 35px; border-bottom-left-radius: 35px; flex-direction: row; align-items: center; justify-content: space-around; visibility: visible;">
                    <ui:VisualElement name="IconoUbicacion" style="flex-grow: 0; background-image: url(&apos;project://database/Assets/ImagenesUI/loading.png?fileID=21300000&amp;guid=af31b504348b20641856940d2e4fcf0a&amp;type=3#loading&apos;); width: 140px; height: 140px; flex-shrink: 0;" />
                    <ui:Label tabindex="-1" text="Esperando Conexión" parse-escape-sequences="true" display-tooltip-when-elided="true" enable-rich-text="true" style="font-size: 50px; justify-content: center; color: rgb(255, 255, 255); -unity-font: url(&apos;project://database/Assets/TextMesh%20Pro/Fonts/AsapCondensed-Medium.ttf?fileID=12800000&amp;guid=b4724283f3c12a341b33dad61381d632&amp;type=3#AsapCondensed-Medium&apos;); -unity-font-style: normal; width: 65%; white-space: normal; -unity-font-definition: url(&apos;project://database/Assets/TextMesh%20Pro/Fonts/AsapCondensed-Medium%20SDF.asset?fileID=11400000&amp;guid=18e2dc100ccda304b9bb9b4a77e66274&amp;type=2#AsapCondensed-Medium SDF&apos;);" />
                </ui:VisualElement>
                <ui:VisualElement name="ContenedorInformacion" style="flex-grow: 0; flex-shrink: 0; width: 15%; height: 50%; background-color: rgba(0, 0, 0, 0); border-top-left-radius: 35px; border-top-right-radius: 35px; border-bottom-right-radius: 35px; border-bottom-left-radius: 35px; flex-direction: row; align-items: center; justify-content: center; display: flex; visibility: visible;">
                    <ui:Button text="Button" parse-escape-sequences="true" display-tooltip-when-elided="true" name="inicio_forzado" />
                </ui:VisualElement>
                <ui:VisualElement name="ContenedorInformacion" style="flex-grow: 0; flex-shrink: 0; width: 17%; height: 50%; background-color: rgba(0, 0, 0, 0); border-top-left-radius: 35px; border-top-right-radius: 35px; border-bottom-right-radius: 35px; border-bottom-left-radius: 35px; flex-direction: row; align-items: center; justify-content: center; margin-right: 25px;" />
            </ui:VisualElement>
            <ui:VisualElement name="BarraInfoExtra" style="flex-grow: 0; flex-shrink: 0; height: 15%; flex-direction: row; align-items: center; justify-content: space-around; margin-top: 0; width: 95%;">
                <ui:VisualElement name="ContenedorInformacion" style="flex-grow: 0; flex-shrink: 0; width: 15%; height: 50%; background-color: rgba(0, 0, 0, 0); border-top-left-radius: 35px; border-top-right-radius: 35px; border-bottom-right-radius: 35px; border-bottom-left-radius: 35px; flex-direction: row; align-items: center; justify-content: center;" />
                <ui:VisualElement name="ContenedorInformacion" style="flex-grow: 0; flex-shrink: 0; width: 17%; height: 50%; background-color: rgba(0, 0, 0, 0); border-top-left-radius: 35px; border-top-right-radius: 35px; border-bottom-right-radius: 35px; border-bottom-left-radius: 35px; flex-direction: row; align-items: center; justify-content: center; margin-right: 25px;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Footer" style="flex-grow: 0; flex-shrink: 0; height: 50%; justify-content: flex-end;">
            <ui:VisualElement name="Barra" style="flex-grow: 0; flex-shrink: 0; height: 50%; flex-direction: row; align-items: center; justify-content: center;">
                <ui:VisualElement name="ContenedorDatos" style="flex-grow: 0; flex-shrink: 0; width: 900px; height: 336px; background-color: rgba(0, 0, 0, 0.51); border-top-left-radius: 35px; border-top-right-radius: 35px; border-bottom-right-radius: 35px; border-bottom-left-radius: 35px; flex-direction: row; align-items: center; justify-content: center;">
                    <ui:VisualElement name="ImagenActual" style="flex-grow: 0; background-image: url(&apos;project://database/Assets/ImagenesUI/Dragon/DUDA-DRAGON.png?fileID=21300000&amp;guid=338fd4f0bb21bc342b1f6ec6fc697a37&amp;type=3#DUDA-DRAGON&apos;); width: 250px; height: 300px; flex-shrink: 0; border-top-left-radius: 30px; border-top-right-radius: 30px; border-bottom-right-radius: 30px; border-bottom-left-radius: 30px; margin-right: 25px;" />
                    <ui:VisualElement name="ContenedorDatos" style="flex-grow: 0; flex-shrink: 0; width: 60%;">
                        <ui:Label tabindex="-1" text="¡Porfavor espera a establecer la conexión con nuestros sensores!" parse-escape-sequences="true" display-tooltip-when-elided="true" enable-rich-text="true" name="texto_jack_en_escena_qr" style="font-size: 60px; justify-content: center; color: rgb(255, 255, 255); -unity-font: url(&apos;project://database/Assets/TextMesh%20Pro/Fonts/AsapCondensed-Medium.ttf?fileID=12800000&amp;guid=b4724283f3c12a341b33dad61381d632&amp;type=3#AsapCondensed-Medium&apos;); -unity-font-style: normal; margin-bottom: 30px; white-space: normal; -unity-font-definition: url(&apos;project://database/Assets/TextMesh%20Pro/Fonts/AsapCondensed-Medium%20SDF.asset?fileID=11400000&amp;guid=18e2dc100ccda304b9bb9b4a77e66274&amp;type=2#AsapCondensed-Medium SDF&apos;);" />
                        <ui:VisualElement name="BarraSeparadora" style="flex-grow: 0; color: rgb(255, 255, 255); flex-shrink: 0; width: 100%; height: 2px; background-color: rgb(255, 255, 255); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px;" />
